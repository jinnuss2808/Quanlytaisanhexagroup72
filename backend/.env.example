# Node.js backend. Copy to .env and edit values. Never commit real secrets.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
FIREBASE_PROJECT_ID=tickethexaa
FIREBASE_DATABASE_URL=https://tickethexaa-default-rtdb.firebaseio.com
# Point to your Firebase Admin SDK downloaded JSON, outside source code.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/private/service-account.json
# Optional; only needed for asset image upload.
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ASSIGNMENT_SWEEP_MS=30000
REMINDER_SWEEP_MS=30000
